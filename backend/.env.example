# CivicHelp Operational Environment Configuration

# ----------------------------------------------------
# 1. Google Gemini AI Configuration (Official SDK)
# ----------------------------------------------------
# Obtain your free Gemini API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1024

# ----------------------------------------------------
# 2. Database & Server Settings
# ----------------------------------------------------
DATABASE_URL=sqlite:///./civichelp.db

# ----------------------------------------------------
# 3. Authentication & Security
# ----------------------------------------------------
JWT_SECRET_KEY=civichelp-production-secret-key-32chars-min-secure-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_INITIAL_EMAIL=admin@civichelp.gov.in
ADMIN_INITIAL_PASSWORD=CivicHelp@Admin2026!

# ----------------------------------------------------
# 4. Intelligence & Demonstration Modes
# ----------------------------------------------------
DEMO_MODE=true
DEFAULT_DEMO_COUNT=450
NEWS_ENABLED=true
