# ========================================================
# CIVICHELP ENVIRONMENT CONFIGURATION
# ========================================================

# Application
PROJECT_NAME="CivicHelp"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./civichelp.db"

# Google Gemini AI Configuration
# Get an official key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_OUTPUT_TOKENS=1024

# Government Portal Authentication & JWT Security
JWT_SECRET_KEY="replace-with-a-random-32-character-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_INITIAL_EMAIL="admin@civichelp.gov.in"
ADMIN_INITIAL_PASSWORD="CivicHelp@Admin2026!"

# Public Intelligence & News Provider
NEWS_PROVIDER="CIVIC_TELEMETRY"
NEWS_API_KEY=""
NEWS_ENABLED=true
NEWS_CACHE_TTL_SECONDS=300

# Demo & Synthetic Data Settings
DEMO_MODE=true
DEFAULT_DEMO_COUNT=450
