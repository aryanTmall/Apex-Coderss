# ---------------------------------------------
# CivicHelp .gitignore
# ---------------------------------------------

# Secrets and Environment Variables
.env
*.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local

# Node Dependencies and Build Artifacts
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm/

# Python Cache, Bytecode and Virtual Environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*/.pytest_cache/
venv/
env/
.venv/
ENV/

# Local SQLite Databases
*.db
*.sqlite
*.sqlite3
backend/*.db
!backend/civichelp_seed.db

# Logs and OS Artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local Uploads
uploads/
backend/uploads/
